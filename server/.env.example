# ── Сервер ─────────────────────────────────────────────
PORT=8080
# Откуда пускаем фронт (Vercel сейчас, потом домен Beget). Через запятую.
FRONTEND_ORIGIN=https://life-cod-v2.vercel.app,http://localhost:5173
# Адрес самого сайта, для ссылок в Робокассе и письмах
SITE_URL=https://life-cod-v2.vercel.app

# ── База MySQL (Beget Cloud DB, приватный хост) ────────
DB_HOST=10.16.0.1
DB_PORT=3306
DB_USER=default-db
DB_PASSWORD=ЗАМЕНИ_НА_ПАРОЛЬ_ИЗ_ПАНЕЛИ
DB_NAME=default-db

# ── Авторизация ────────────────────────────────────────
# Длинная случайная строка, придумай свою
JWT_SECRET=ЗАМЕНИ_НА_ДЛИННУЮ_СЛУЧАЙНУЮ_СТРОКУ

# ── Робокасса ──────────────────────────────────────────
ROBOKASSA_LOGIN=
ROBOKASSA_PASS1=
ROBOKASSA_PASS2=
ROBOKASSA_PASS1_TEST=
ROBOKASSA_PASS2_TEST=
ROBOKASSA_IS_TEST=true

# ── ИИ (proxyapi), ключ теперь на сервере, не в бандле ─
AI_API_KEY=

# ── Оплата Telegram-бота ───────────────────────────────
# Общий секрет между сервером и ботом. Впиши одну и ту же строку
# сюда и в .env бота (BOT_SHARED_SECRET). Можно оставить пустым
# для локального теста, тогда защита секретом отключена.
BOT_SHARED_SECRET=
